# Structurizr DevOps Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Admin API Configuration
# =============================================================================
# The plaintext Admin API key (keep this secret!)
# Generate a secure key with: openssl rand -hex 32
STRUCTURIZR_ADMIN_API_KEY=your-secret-admin-api-key-here

# =============================================================================
# Domain Workspace Credentials (populated by init-workspace.sh)
# =============================================================================
# Each domain has its own workspace credentials.
# Run: ./scripts/init-workspace.sh <domain-name> to generate these.

# Platform Domain
STRUCTURIZR_PLATFORM_WORKSPACE_ID=
STRUCTURIZR_PLATFORM_WORKSPACE_KEY=
STRUCTURIZR_PLATFORM_WORKSPACE_SECRET=

# Orders Domain
STRUCTURIZR_ORDERS_WORKSPACE_ID=
STRUCTURIZR_ORDERS_WORKSPACE_KEY=
STRUCTURIZR_ORDERS_WORKSPACE_SECRET=

# Notifications Domain
STRUCTURIZR_NOTIFICATIONS_WORKSPACE_ID=
STRUCTURIZR_NOTIFICATIONS_WORKSPACE_KEY=
STRUCTURIZR_NOTIFICATIONS_WORKSPACE_SECRET=

# =============================================================================
# On-Premises URL
# =============================================================================
STRUCTURIZR_URL=http://localhost:20000/api

# =============================================================================
# GitHub Actions Runner (Optional)
# =============================================================================
# Configure with: ./cli runner:init
#
# Token options (choose one):
# 1. Registration token (short-lived, 1 hour): ./cli runner:init
# 2. Personal Access Token (persistent): ./cli runner:init --pat <your-pat>
#
# To create a PAT: GitHub Settings → Developer settings → Personal access tokens
# Required scopes: repo (for private repos) or public_repo (for public repos)
GITHUB_REPO_URL=
GITHUB_RUNNER_TOKEN=
GITHUB_RUNNER_NAME=structurizr-runner
